{
  "$schema": "https://github.com/open-rpc/meta-schema/releases/latest/download/open-rpc-meta-schema.json",
  "openrpc": "1.3.2",
  "info": {
    "version": "1.0.0",
    "title": "OpenMower"
  },
  "methods": [
    {
      "name": "rpc.ping",
      "summary": "Ping the server.",
      "params": [],
      "result": {
        "name": "result",
        "description": "Returns \"pong\" if successful.",
        "schema": {
          "type": "string",
          "enum": [
            "pong"
          ]
        }
      }
    },
    {
      "name": "rpc.methods",
      "summary": "List all available methods.",
      "params": [],
      "result": {
        "name": "methods",
        "description": "An array of method names (e.g. \"rpc.ping\").",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "map.replace",
      "summary": "Replace the current map with a new one.",
      "params": [
        {
          "name": "map",
          "description": "The new map in JSON format",
          "required": true,
          "schema": {
            "type": "object"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "No result is returned if successful.",
        "schema": {
          "type": "null"
        }
      }
    },
    {
      "name": "map.start_in_area",
      "summary": "Trigger mowing to start in a specific working area.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "area_index",
          "description": "Zero-based index into the type=='mow' filtered area list (matches robot_state.current_area).",
          "required": true,
          "schema": {"type": "integer", "minimum": 0}
        }
      ],
      "result": {
        "name": "result",
        "description": "No result is returned if successful.",
        "schema": {"type": "null"}
      }
    },
    {
      "name": "meta.rpc.ping",
      "summary": "Ping the meta server.",
      "params": [],
      "result": {
        "name": "result",
        "description": "Returns \"pong\" if successful.",
        "schema": {
          "type": "string",
          "enum": [
            "pong"
          ]
        }
      }
    },
    {
      "name": "meta.config.schema",
      "summary": "Get the configuration schema.",
      "params": [],
      "result": {
        "name": "result",
        "description": "Returns the JSON schema for the configuration.",
        "schema": {
          "type": "string"
        }
      }
    },
    {
      "name": "meta.config.defaults",
      "summary": "Get the default configuration values.",
      "params": [],
      "result": {
        "name": "result",
        "description": "Returns an object where each key is a relative path and the value is the content of a YAML file as a string.",
        "schema": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "description": "Content of a YAML file as a string"
          },
          "description": "Keys are relative file paths, values are YAML file contents as strings"
        }
      }
    },
    {
      "name": "meta.config.get",
      "summary": "Read the live mower_config.sh as a flat key/value object.",
      "params": [],
      "result": {
        "name": "result",
        "description": "Object whose keys are environment-variable names and values are their current string values.",
        "schema": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    {
      "name": "meta.config.set",
      "summary": "Apply a set of changes to mower_config.sh atomically.",
      "params": [
        {
          "name": "changes",
          "description": "Object with the keys to write. Existing keys are updated in place; new keys are appended.",
          "required": true,
          "schema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Number of changes applied.",
        "schema": {
          "type": "object",
          "properties": {
            "updated": {"type": "integer"}
          }
        }
      }
    },
    {
      "name": "params.set",
      "summary": "Set a single ROS parameter, optionally triggering dynamic_reconfigure on the owning node.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "name",
          "description": "Fully-qualified ROS parameter name, e.g. /mower_logic/foo.",
          "required": true,
          "schema": {"type": "string"}
        },
        {
          "name": "value",
          "description": "New value (boolean, integer, number or string).",
          "required": true,
          "schema": {}
        }
      ],
      "result": {
        "name": "result",
        "description": "No result is returned if successful.",
        "schema": {"type": "null"}
      }
    },
    {
      "name": "schedule.list",
      "summary": "List all configured mowing schedules.",
      "params": [],
      "result": {
        "name": "schedules",
        "description": "Array of schedule entries.",
        "schema": {
          "type": "array",
          "items": {"$ref": "#/components/schemas/Schedule"}
        }
      }
    },
    {
      "name": "schedule.upsert",
      "summary": "Insert or update a schedule. The ID is generated server-side when missing.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "schedule",
          "description": "Schedule definition.",
          "required": true,
          "schema": {"$ref": "#/components/schemas/Schedule"}
        }
      ],
      "result": {
        "name": "schedule",
        "description": "The persisted schedule (with the assigned id).",
        "schema": {"$ref": "#/components/schemas/Schedule"}
      }
    },
    {
      "name": "schedule.delete",
      "summary": "Remove a schedule by id.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "id",
          "description": "Schedule id to delete.",
          "required": true,
          "schema": {"type": "string"}
        }
      ],
      "result": {
        "name": "result",
        "description": "No result is returned if successful.",
        "schema": {"type": "null"}
      }
    },
    {
      "name": "system.restart_service",
      "summary": "Restart a whitelisted systemd unit on the mower host.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "service",
          "description": "Service name. Defaults to the main mower service.",
          "required": false,
          "schema": {
            "type": "string",
            "enum": ["openmower", "mower_logic", "xbot_monitoring", "move_base_flex"]
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Acknowledgement. May time out if the responding service restarts itself.",
        "schema": {
          "type": "object",
          "properties": {"ok": {"type": "boolean"}}
        }
      }
    },
    {
      "name": "logs.tail",
      "summary": "Read recent log lines from a node or 'all' sources on the mower host.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "source",
          "description": "Source filter. 'all' aggregates every known node.",
          "required": false,
          "schema": {
            "type": "string",
            "enum": ["all", "mower_logic", "xbot_monitoring", "mower_scheduler", "move_base_flex"]
          }
        },
        {
          "name": "lines",
          "description": "Number of trailing lines to return (50–5000).",
          "required": false,
          "schema": {"type": "integer", "minimum": 50, "maximum": 5000}
        }
      ],
      "result": {
        "name": "result",
        "description": "List of normalised log entries.",
        "schema": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ts", "level", "msg", "source"],
                "properties": {
                  "ts": {"type": "number", "description": "Epoch seconds."},
                  "level": {"type": "string", "enum": ["debug", "info", "warn", "error"]},
                  "msg": {"type": "string"},
                  "source": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "telemetry.list_sessions",
      "summary": "Enumerate recorded mowing telemetry sessions.",
      "params": [],
      "result": {
        "name": "result",
        "description": "List of recorded sessions with summary metadata.",
        "schema": {
          "type": "object",
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "start_ts", "end_ts", "sample_count"],
                "properties": {
                  "id": {"type": "string"},
                  "start_ts": {"type": "number", "description": "Epoch seconds."},
                  "end_ts": {"type": "number"},
                  "sample_count": {"type": "integer"},
                  "file_size_bytes": {"type": "integer"},
                  "duration_s": {"type": "number"}
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "telemetry.get_session",
      "summary": "Fetch the recorded telemetry samples for a single mowing session.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "id",
          "description": "Session id from telemetry.list_sessions.",
          "required": true,
          "schema": {"type": "string"}
        },
        {
          "name": "stride",
          "description": "Decimation factor (return every N-th sample). Default 1 = full resolution.",
          "required": false,
          "schema": {"type": "integer", "minimum": 1}
        }
      ],
      "result": {
        "name": "result",
        "description": "Sample stream for the session.",
        "schema": {
          "type": "object",
          "properties": {
            "samples": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ts", "x", "y"],
                "additionalProperties": {"type": "number"},
                "properties": {
                  "ts": {"type": "number"},
                  "x": {"type": "number"},
                  "y": {"type": "number"},
                  "yaw": {"type": "number"},
                  "pitch": {"type": "number"},
                  "roll": {"type": "number"},
                  "gps_fix_type": {"type": "integer"},
                  "gps_satellite_count": {"type": "integer"},
                  "gps_pdop": {"type": "number"},
                  "wifi_dbm": {"type": "number"},
                  "wifi_q": {"type": "number"}
                }
              }
            },
            "truncated": {"type": "boolean"}
          }
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "Schedule": {
        "type": "object",
        "required": ["name", "enabled", "areas", "rrule", "duration_minutes"],
        "properties": {
          "id": {"type": "string", "description": "Generated server-side when omitted."},
          "name": {"type": "string"},
          "enabled": {"type": "boolean"},
          "areas": {"type": "array", "items": {"type": "integer"}},
          "rrule": {"type": "string", "description": "iCal RRULE string."},
          "duration_minutes": {"type": "integer", "minimum": 1},
          "weather": {
            "type": "object",
            "properties": {"skip_if_rain": {"type": "boolean"}}
          },
          "pattern": {
            "type": "object",
            "properties": {
              "angle_offset": {"type": "number"},
              "rotate_by_days": {"type": "integer"}
            }
          }
        }
      }
    }
  }
}
